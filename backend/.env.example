# ---- Supabase (required) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Face engine: insightface | face_recognition | fallback | auto ----
FACE_ENGINE=insightface
INSIGHTFACE_MODEL=buffalo_l
# STRICT_FACE_ENGINE=true   # fail loudly if the chosen engine isn't installed

# ---- Thresholds (tune per engine; insightface ~0.68-0.72, dlib ~0.6) ----
FACE_MATCH_THRESHOLD=0.68
MIN_FACE_CONFIDENCE=0.7
MAX_ALLOWED_FACES=1
LIVENESS_THRESHOLD=0.7
LIVENESS_FRAME_COUNT=5

# ---- Server ----
ALLOWED_ORIGINS=http://localhost:5173,https://gprocessor.github.io
PORT=8000
